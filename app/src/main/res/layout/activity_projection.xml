<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090B0F">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true" />

    <TextView
        android:id="@+id/proj_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="24dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="#B3000000"
        android:text="MYTV"
        android:textColor="#FF4D5E"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- The head unit has no system back button, so the projection needs an
         explicit way out that returns to the channel list. -->
    <TextView
        android:id="@+id/proj_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="20dp"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="#CC161A22"
        android:clickable="true"
        android:focusable="true"
        android:text="✕  Channels"
        android:textColor="#F3F5FF"
        android:textSize="15sp"
        android:textStyle="bold" />

</FrameLayout>
