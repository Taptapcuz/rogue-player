<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B10">

    <!-- Video / audio surface -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"
        app:resize_mode="fit"
        android:keepScreenOn="true" />

    <!-- Top bar: title + close -->
    <LinearLayout
        android:id="@+id/player_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/player_top_scrim"
        android:padding="14dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/player_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#F3F5FF"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/player_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#F3F5FF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/player_aspect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="#1D1D26"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="7dp"
            android:text="Auto"
            android:textColor="#F3F5FF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Buffering overlay -->
    <ProgressBar
        android:id="@+id/player_buffering"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="#3D7BFF"
        android:visibility="gone" />

    <!-- Error / message overlay -->
    <LinearLayout
        android:id="@+id/player_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#E60B0B10"
        android:visibility="gone">

        <TextView
            android:id="@+id/player_error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:gravity="center"
            android:textColor="#9CA2C0"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/player_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="#3D7BFF"
            android:gravity="center"
            android:text="Retry"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
