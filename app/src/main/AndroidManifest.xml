<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Mic for in-car web voice search (WebView getUserMedia), like CarStream. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The car's Videos page lists the phone's own video library (MediaStore).
         Requested at runtime from the car page; the dialog lands on the phone. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Android Auto / Android for Cars projection surface -->
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="android.car.permission.CAR_SPEED" />

    <application
        android:name=".MyApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.RoguePlayer"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true">

        <!-- Android Auto reads car capability from THESE two elements, and only
             when they sit directly under <application>. They used to be nested
             inside the CarAppService, where the gearhead validator never looks —
             which is what produced "Min API level not declared in manifest
             (androidx.car.app.minCarApiLevel)" and the host's generic
             "MYTV has encountered an unexpected error" screen. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <!-- ============ Phone UI ============ -->
        <!-- Splash is the launcher: branded boot screen that hands off to MainActivity. -->
        <!-- Launcher icon per boot-screen colour. Exactly ONE alias is enabled at a time
             (AppIcon.apply); switching re-skins the icon without reinstalling. SplashActivity
             itself no longer carries the LAUNCHER filter, or you would get two icons. -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.RoguePlayer" />

        <activity-alias
            android:name=".Launcher.blue"
            android:targetActivity=".ui.SplashActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher_blue"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Launcher.cyan"
            android:targetActivity=".ui.SplashActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_cyan"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Launcher.violet"
            android:targetActivity=".ui.SplashActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_violet"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Launcher.teal"
            android:targetActivity=".ui.SplashActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_teal"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Launcher.amber"
            android:targetActivity=".ui.SplashActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_amber"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Launcher.green"
            android:targetActivity=".ui.SplashActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_green"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Launcher.red"
            android:targetActivity=".ui.SplashActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_red"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Launcher.pink"
            android:targetActivity=".ui.SplashActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_pink"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Launcher.magenta"
            android:targetActivity=".ui.SplashActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_magenta"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Launcher.lime"
            android:targetActivity=".ui.SplashActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_lime"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Launcher.sky"
            android:targetActivity=".ui.SplashActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_sky"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Launcher.white"
            android:targetActivity=".ui.SplashActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_white"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.RoguePlayer">
        </activity>

        <!-- Full-screen settings (tap the Rogue Player brand in MainActivity) -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.RoguePlayer" />

        <!-- Fullscreen phone player -->
        <activity
            android:name=".ui.PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:launchMode="singleTask"
            android:theme="@style/Theme.RoguePlayer" />

        <!-- Movie / show detail page (metadata, trailer, play, episodes) -->
        <activity
            android:name=".ui.DetailActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:theme="@style/Theme.RoguePlayer" />

        <!-- In-app browser (YouTube mobile + anything else); WebView only, no car surface.
             Exported so adb and other apps can hand it a URL (am start with the url extra). -->
        <activity
            android:name=".ui.BrowserActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:theme="@style/Theme.RoguePlayer" />

        <!-- The phone's own video folders (landing tile); plays content:// URIs. -->
        <activity
            android:name=".ui.FoldersActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:theme="@style/Theme.RoguePlayer" />

        <!-- TiViMate-style TV guide -->
        <activity
            android:name=".ui.GuideActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:theme="@style/Theme.RoguePlayer" />

        <!-- ============ Car projection (Car App Library templates) ============ -->
        <!-- CarAppService: the projection service Android Auto binds to.
             NAVIGATION category grants unrestricted surface drawing. The legacy
             com.google.android.gms.car.category.CATEGORY_PROJECTION entry and the
             Fermata-style projection route are gone: that path needs the unpublished
             auto-sdk plus a Google allowlist, so it can never work here. -->
        <service
            android:name=".car.RogueCarService"
            android:exported="true"
            android:label="@string/car_service_label">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

        <!-- Projection activity: renders the phone's surface onto the car screen -->
        <activity
            android:name=".car.ProjectionActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:taskAffinity="com.rogueplayer.car">
        </activity>

        <!-- Mirror service: reads the car surface + renders content/video -->
        <service
            android:name=".car.MirrorService"
            android:exported="false" />

        <!-- Media playback service (audio fallback + media session) -->
        <service
            android:name=".player.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
